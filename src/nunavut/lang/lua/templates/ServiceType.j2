{%- include '_header.j2' %}
{%- include '_requires.j2' %}
{%- import 'register.j2' as register with context %}
{%- import 'declare.j2' as declare with context %}
{%- import 'decode.j2' as decode with context %}
{%- set type = T %}
{%- set name = T | short_reference_name %}

{{ declare.constants(type.request_type) }}
{{ declare.constants(type.response_type) }}

{{ declare.extents(type) }}

-- Initialize field tables for dot notation
local {{ type | full_reference_name }} = {}
{{ declare.fields_request(type, type.request_type) }}
{{ declare.fields_response(type, type.response_type) }}

-- local flag to prevent multiple inclusion
local {{ type | full_reference_name }}_registered = false

-- Registers the fields of the message to the Proto
-- @param cyphal_proto The Proto to add the fields to
local function register_{{ type | full_reference_name }}(cyphal_proto)
    if not {{ type | full_reference_name }}_registered then
        {{ register.fields_request(type, type.request_type) }}
        {{ register.subtypes(type.request_type) }}
        {{ register.fields_response(type, type.response_type) }}
        {{ register.subtypes(type.response_type) }}
        {{ type | full_reference_name }}_registered = true
    end
end

{{ decode.function_request(type, type.request_type, 'REQUEST_EXTENT') }}
{{ decode.function_response(type, type.response_type, 'RESPONSE_EXTENT') }}

-- Decodes a {{ type | full_reference_name }} as a top level Service.
-- Returns the number of bytes decoded
-- @param proto The protocol type
-- @param payload The TVB of all the data
-- @param offset The offset in the payload where we need to start parsing from
-- @param pinfo ???
-- @param payload_tree The tree to attach dissected values to
-- @param label The text string to attach to the data
-- @param request_not_response True if a request, false if a response
local function decode_{{ type | full_reference_name }}(proto, payload, offset, pinfo, payload_tree, label, request_not_response)
    if request_not_response == 1 then -- Request
        return decode_{{ type | full_reference_name }}_Request(proto, payload, offset, REQUEST_EXTENT, pinfo, payload_tree, label)
    else -- Response
        return decode_{{ type | full_reference_name }}_Response(proto, payload, offset, RESPONSE_EXTENT, pinfo, payload_tree, label)
    end
end

-- Return the decode, register and the option port id
return {
    register = register_{{ type | full_reference_name }}
    , decode = decode_{{ type | full_reference_name }}
    , response = {
        extent = RESPONSE_EXTENT
    }
    , request = {
        extent = REQUEST_EXTENT
    }
{%- if type.has_fixed_port_id %}
{%- if type.has_parent_service %}
    , service_id = {{ type.fixed_port_id }}
{%- else %}
    , subject_id = {{ type.fixed_port_id }}
{%- endif %}
{%- endif %}
}
