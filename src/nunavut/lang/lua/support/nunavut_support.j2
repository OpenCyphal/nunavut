-- Nunavut Support Library Function for Decoding Primitives in Lua

-- Bounds check helper: returns true if offset + field_size is within the payload
local function in_bounds(payload, offset, field_size)
    return (offset + field_size) <= payload:len()
end

local function decode_payload_uint8(field, payload, offset, field_size, tree)
    if not in_bounds(payload, offset, field_size) then return field_size end
    tvb = payload(offset, field_size)
    value = tvb:le_uint()
    tree:add_le(field, tvb)
    return field_size
end

